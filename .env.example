# Supabase public client configuration (URL and anon key are public; protect data with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase credentials (NEVER use VITE_ prefix)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Offline login values injected at build time by GitHub Actions.
# Keep these in GitHub Actions Secrets, not in the repository.
# NOTE: VITE_ values are embedded in the APK/web bundle and can be extracted.
VITE_OFFLINE_LOGIN_LAST_NAME=
VITE_OFFLINE_LOGIN_FIRST_NAME=
VITE_OFFLINE_LOGIN_BIRTH_DATE=
VITE_OFFLINE_LOGIN_PIN=
VITE_OFFLINE_LOGIN_PASSWORD=

# Server-only API protection; must be a long random value (32+ bytes)
REPORTS_API_KEY=

# CORS: allowed web origins, comma-separated
CORS_ORIGIN=

# Miscellaneous
PING_MESSAGE=ping pong
