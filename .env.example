# Supabase public client configuration (URL and anon key are public; protect data with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase credentials (NEVER use VITE_ prefix)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Temporary inputs used ONLY to generate a verifier. Fill these in your local .env,
# run: node scripts/generate-offline-login-hash.mjs
# Then copy the generated VITE_* values to GitHub Actions Secrets and remove these inputs.
OFFLINE_LOGIN_LAST_NAME=
OFFLINE_LOGIN_FIRST_NAME=
OFFLINE_LOGIN_BIRTH_DATE=
OFFLINE_LOGIN_PIN=
OFFLINE_LOGIN_PASSWORD=

# PBKDF2 verifier injected at build time from GitHub Actions Secrets.
# The verifier is extractable from the APK; it is safer than plaintext but not server-grade.
VITE_OFFLINE_LOGIN_SALT=
VITE_OFFLINE_LOGIN_HASH=

# Server-only API protection; must be a long random value (32+ bytes)
REPORTS_API_KEY=

# CORS: allowed web origins, comma-separated
CORS_ORIGIN=

# Miscellaneous
PING_MESSAGE=ping pong
