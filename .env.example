# Supabase public client configuration (URL and anon key are public; protect data with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase credentials (NEVER use VITE_ prefix)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Offline login PBKDF2 verifier (generated by scripts/generate-offline-login-hash.mjs)
# Set VITE_OFFLINE_LOGIN_SALT and VITE_OFFLINE_LOGIN_HASH as GitHub Actions Secrets.
# The verifier is still present in the distributed app; offline auth is not server-grade.
VITE_OFFLINE_LOGIN_SALT=
VITE_OFFLINE_LOGIN_HASH=

# Server-only API protection; must be a long random value (32+ bytes)
REPORTS_API_KEY=

# CORS: allowed web origins, comma-separated
CORS_ORIGIN=

# Miscellaneous
PING_MESSAGE=ping pong
